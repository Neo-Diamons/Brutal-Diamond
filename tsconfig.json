{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "svelte", "node", "@vitest/browser-playwright"]
	},
	"include": ["src", ".storybook", "vite.config.ts", "eslint.config.ts"]
}
