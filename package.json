{
	"name": "brutal-diamond",
	"version": "0.0.1",
	"license": "MIT",
	"author": {
		"name": "Diamons",
		"url": "https://github.com/Neo-Diamons"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Neo-Diamons/Brutal-Diamond.git"
	},
	"homepage": "https://github.com/Neo-Diamons/Brutal-Diamond#readme",
	"bugs": {
		"url": "https://github.com/Neo-Diamons/Brutal-Diamond/issues"
	},
	"type": "module",
	"engines": {
		"node": "24.x",
		"npm": "11.x"
	},
	"scripts": {
		"build": "svelte-package -i src && publint",
		"storybook": "storybook dev -p 6006 --no-open",
		"build-storybook": "storybook build",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest --run --coverage",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.stories.*",
		"!dist/testing"
	],
	"sideEffects": [
		"**/*.css",
		"./dist/styles/theming/font.js"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles/index.css",
		"./themes/outline.css": "./dist/styles/theming/themes/outline.css",
		"./modes/dark.css": "./dist/styles/theming/modes/dark.css",
		"./font": {
			"types": "./dist/styles/theming/font.d.ts",
			"default": "./dist/styles/theming/font.js"
		}
	},
	"peerDependencies": {
		"@fontsource-variable/karla": "^5.0.0",
		"svelte": "^5.29.0"
	},
	"peerDependenciesMeta": {
		"@fontsource-variable/karla": {
			"optional": true
		}
	},
	"prettier": {
		"useTabs": true,
		"singleQuote": true,
		"trailingComma": "none",
		"printWidth": 100,
		"plugins": [
			"prettier-plugin-svelte"
		]
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/karla": "^5.3.0",
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/addon-vitest": "^10.6.2",
		"@storybook/svelte-vite": "^10.6.2",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"@vitest/browser": "^5.0.5",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/coverage-v8": "^5.0.5",
		"axe-core": "^4.14.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.2",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"jiti": "^2.7.0",
		"phosphor-svelte": "^3.1.1",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"storybook": "^10.6.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"description": "Neo-brutalist Svelte 5 component library with design tokens",
	"keywords": [
		"svelte",
		"svelte5",
		"ui",
		"components",
		"neo-brutalism",
		"design-tokens"
	]
}
